doctype html
html(lang="en")
    head
        meta(charset="UTF-8")
        meta(name="viewport", content="width=device-width, initial-scale=1.0")

        link(rel="preconnect" href="https://fonts.googleapis.com")
        link(rel="preconnect" href="https://fonts.gstatic.com" crossorigin)
        link(href="https://fonts.googleapis.com/css2?family=Noto+Sans:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet")
        link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css")
        link(href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet")
        link(href="https://code.jquery.com/ui/1.14.1/themes/base/jquery-ui.css" rel="stylesheet")
        link(href="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.9.0/slick.min.css" rel="stylesheet")


        noscript
            link(rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;700&display=swap")
        link(rel='stylesheet', href='https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.css')
        link(rel="stylesheet", href="assets/_css/app.css" media="print" onload="this.onload=null;this.removeAttribute('media');")
        link(rel="stylesheet", href="assets/_css/style.css" media="print" onload="this.onload=null;this.removeAttribute('media');")
        //- link(rel="stylesheet", href="assets/css/app.min.css" media="print" onload="this.onload=null;this.removeAttribute('media');")
        noscript
            link(rel="stylesheet", href="assets/_css/app.css")
            //- link(rel="stylesheet", href="assets/css/app.min.css")
        title Double Taxation Agreements
    body.inner-page
        - let activeLink = 'Resource'

        include ../partials/_header
        
        include ../mixins/_sections
        include ../mixins/_section-title
        include ../mixins/_breadcrumbs
        include ../mixins/_inner-banner
        include ../mixins/_tab-list
        +innerBanner('','Double Taxation Agreements', '', 'inner-banner-normal')  
        +breadcrumbNav('', 'breadcrumb-menu','', { link: 'index.html', text: 'Home', id: 'Home'}, { link: 'Resource Centre.html', text: 'Resource Centre', id: 'Resource Centre'}, { link: 'Double Taxation Agreements.html', text: 'Double Taxation Agreements', id: activeLink})
        +section('py-5')
            .row.align-items-center.justify-content-between
                .col-lg-6
                    h4.fw-500.fs-32.text-primary What is a Double Taxation Agreement?
                    p.fs-20.fw-400.text-secondary Double taxation occurs when the same person is subject to tax on the same items of income (and/or capital) in more than one jurisdiction. If it remains unaddressed, double taxation can hinder international trade and economic growth.
                .col-lg-5
                    figure
                        img.img-fluid.fig-radius(src='assets/images/double-taxation.png', loading='lazy', width='', height='', alt='')
        include ../partials/_taxation
        //- include ../partials/_reporting

        include ../partials/_footer
        script(src='https://cdnjs.cloudflare.com/ajax/libs/jquery/3.5.1/jquery.min.js')
        //- script(src='assets/js/vendor/swiper-bundle.min.js')
        script(src='https://cdn.jsdelivr.net/npm/swiper@10/swiper-bundle.min.js')
        script(src='https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js')
        script(src="https://code.jquery.com/ui/1.14.1/jquery-ui.js")
        script(src="https://cdnjs.cloudflare.com/ajax/libs/slick-carousel/1.9.0/slick.min.js")
        script(src='assets/js/header.js')
        script(src='assets/js/custom.js')


        //- script(src='https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js')
    
        script(async, src="https://cdn.jsdelivr.net/npm/es-module-shims@1/dist/es-module-shims.min.js", crossorigin="anonymous")
        script(type="importmap").
            {
                "imports": {
                    "@popperjs/core": "https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/esm/popper.min.js",
                    "bootstrap": "https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.esm.min.js"
                }
            }
        script(type="module").
            import { Popover } from 'bootstrap';
            //- new Popover(document.getElementById('popoverButton'))

        script.
            document.querySelectorAll('.open-panel').forEach(link => {
                link.addEventListener('click', function (e) {
                    e.preventDefault();

                    const pdfUrl = this.getAttribute('data-pdf');

                    // Set PDF only when clicked
                    document.getElementById('pdfViewer').src = pdfUrl;

                    // Open panel
                    document.querySelector('.panel-holder').classList.add('active');
                });
            });

            // Close panel
            document.querySelector('.close-panel').addEventListener('click', function () {
                document.querySelector('.panel-holder').classList.remove('active');

                // OPTIONAL: stop PDF when closing
                document.getElementById('pdfViewer').src = "";
            });
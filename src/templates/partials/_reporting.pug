+section('reporting-channels py-60') 
    .row.justify-content-between 
        .col-12.col-lg-6
            +title('mb-4','Reporting Channels','Whistle-blowers may report their concerns by using one of the following channels:') 
            ul
                li Online
                li email
                li post
            p.my-4.fs-20
                a.btn-link(href="#") Click here
                |  to find the Whistleblowing Reporting Guidelines
                
        .col-12.col-lg-5
            +title('mb-4 ','Confidentiality','') 
            ul.fs-20
                li All whistle-blowing channels offer the option to raise concerns anonymously. However, such a choice may make it difficult for the QFCA to communicate with the whistle-blower if additional details are required to initiate the investigation.
                li The QFCA will take all reasonable measures to maintain the confidentiality of the identity of the whistle-blower if the details are provided to the QFCA.
            a.btn(href="#") 
                span.button-text Whistleblowing Reporting 
section.all-in-one-text-media-block-section

    //-
    //- CLASS REFERENCE — add these to .text-media-block
    //- ────────────────────────────────────────────────────────
    //- MEDIA
    //-   (default)              → image
    //-   .with-uploaded-video   → uploaded video (native controls)
    //-   .with-uploaded-video.video-no-controls → uploaded video + custom play/pause
    //-   .with-youtube          → YouTube iframe
    //-
    //- CONTENT
    //-   (default)              → paragraph only
    //-   .with-cta              → paragraph + CTA button
    //-   .with-read-more        → paragraph with read more / read less
    //-   .with-list             → disc bullet list only
    //-   .with-list-cta         → disc bullet list + CTA button
    //-   .with-list-read-more   → disc bullet list with read more / read less
    //-
    //- LIST MARKER (combine with any list variant)
    //-   .list-dash             → replaces disc bullets with an en-dash (–)
    //- ────────────────────────────────────────────────────────

    //- Tab navigation

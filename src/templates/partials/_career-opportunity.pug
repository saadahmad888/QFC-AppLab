+section('career-opportunity pt-0') 
    .row 
        .col-12.col-lg-6.flex-auto.d-flex.flex-column.justify-content-center
            +title('mb-4','Career & Opportunity ', 'Join a fast-growing financial center: QFC’s ecosystem is evolving at pace, creating new possibilities every day. ')
            ul.fs-20.fw-normal.text-secondary.button-list.list-career-opportunity
                li 
                    | Contribute to meaningful work across regulation, licensing, innovation, and asset management — all under one roof.
                li 
                    | Gain exposure to local and regional markets while connecting with global financial flows; QFC’s strategic position offers worldwide reach from Doha. 
                li 
                    | Shape the future by working on emerging priorities such as digital assets, sustainability-linked finance, and fintech regulation. 
            a.btn.btn-transparent.mb-3(href="#")
                span.button-text Apply Now
        .col-d-none.col-lg-1
        .col-12.col-lg-5.flex-auto 
            figure
                img.w-100.rounded-4.discover-img(src="assets/images/discover-qatar.png")

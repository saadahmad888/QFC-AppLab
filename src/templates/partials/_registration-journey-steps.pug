+section('registration') 
        .row 
            .col-12
                +title('mb-lg-5 mb-4 fs-40 fw-medium','How to Get Started?','')  
        .row.custom-row
            .col-lg-4
                .steps.registration-card
                    .steps-header
                        img.steps-header-icon(src="assets/images/icons/star.png", alt="Star icon")
                        .d-flex.justify-content-between.align-items-center
                            div
                                h5.mb-1.fw-bold.fs-40 Today
                                p.mb-0.small.fs-16 Must be completed immediately
                    .steps-body
                        .steps-timeline
                            .step-item
                                .step-number 01
                                .step-content
                                    p.mb-0.text-purple
                                        | Ensure access to the 
                                        a.text-purple.text-decoration-underline(href="#") QFC Client Portal
                            .step-item
                                .step-number 02
                                .step-content
                                    p.mb-0.text-purple
                                        | Start your onboarding journey on 
                                        a.text-purple.text-decoration-underline(href="#") QFC Client Portal
                            .step-item
                                .step-number 03
                                .step-content
                                    p.mb-0.text-purple.fw-medium Get in touch with your assigned Client Relationship Manager
                            .step-item
                                .step-number 04
                                .step-content
                                    h6.text-purple.mb-2.fw-medium.fs-20 Apply for Your Establishment Card
                                    p.mb-2.discription Apply for the Establishment Card (also known as the Computer Card) to obtain a Residence Permit/ QID if you are not a resident of Qatar.
                                    a.fs-16.text-purple.text-decoration-none(href="#") Download Guid
                            .step-item
                                .step-number 05
                                .step-content
                                    h6.text-purple.mb-2.fw-medium.fs-20 Complete Tax Registration & Set Your Start Date
                                    p.mb-0.discription Complete Tax Registration and determine your firm's commencement (start) date of operations.
            .col-lg-4
                .steps.registration-card
                    .steps-header
                        img.steps-header-icon(src="assets/images/icons/calender.svg", alt="calender icon")
                        .d-flex.justify-content-between.align-items-center
                            div
                                h5.mb-1.fw-bold.fs-40 Within 3 Months
                                p.mb-0.small.fs-16 Early compliance steps
                    .steps-body
                        .steps-timeline                                
                            .step-item
                                .step-number 06
                                .step-content
                                    h6.text-purple.mb-2.fw-medium.fs-20 Complete the Registration with the Employment Standards Office (ESO)
                                    p.mb-2.discription Complete your company’s registration under the Legislation and Compliance tab in the portal and
                                    a.fs-16.text-purple.text-decoration-none(href="#") Read More
                            .step-item
                                .step-number 07
                                .step-content
                                    h6.text-purple.mb-2.fw-medium.fs-20 Submit SEF Documents to Monitoring Department
                                    p.mb-2.discription The Senior Executive Function (SEF) of the firm must provide a copy of their Residence Permit/QID 
                                    a.fs-16.text-purple.text-decoration-none(href="#") Read More
                            .step-item
                                .step-number 08
                                .step-content
                                    h6.text-purple.mb-2.fw-medium.fs-20 Provide Professional Indemnity Insurance Coverage
                                    p.mb-2.discription The Senior Executive Function (SEF) of the firm must provide a copy of their Residence Permit/QID 
                                    a.fs-16.text-purple.text-decoration-none(href="#") Read More
                            .step-item
                                .step-number 09
                                .step-content
                                    h6.text-purple.mb-2.fw-medium.fs-20 Appoint a QFC-Approved Auditor
                                    p.mb-2.discription Appoint a QFC-approved auditor from the Public Register within 120 days of incorporation. 
            .col-lg-4
                .steps.registration-card
                    .steps-header
                        img.steps-header-icon(src="assets/images/icons/clock.svg", alt="clock icon")
                        .d-flex.justify-content-between.align-items-center
                            div
                                h5.mb-1.fw-bold.fs-40 Within 6 Months
                                p.mb-0.small.fs-16 Ongoing obligations
                    .steps-body
                        .steps-timeline                                
                            .step-item
                                .step-number 10
                                .step-content
                                    h6.text-purple.mb-2.fw-medium.fs-20 Submit Your Annual Return on the Client Portal
                                    p.mb-2.discription Submit the Annual Return on the Client Portal after one calendar year. (This is different from the Tax Re..)
                                    a.fs-16.text-purple.text-decoration-none(href="#") Read More
                            .step-item
                                .step-number 11
                                .step-content
                                    h6.text-purple.mb-2.fw-medium.fs-20 Submit Your UBO Annual Report
                                    p.mb-2.discription Submit the UBO Annual Report after one calendar year unless there has been no change in shareholding.
                                    a.fs-16.text-purple.text-decoration-none(href="#") Read More
                            .step-item
                                .step-number 12
                                .step-content
                                    h6.text-purple.mb-2.fw-medium.fs-20 Submit the Audited Financial Statement
                                    p.mb-2.discription Submit the Audited Financial Statement on the Client Portal within four months after the financial  
                                    a.fs-16.text-purple.text-decoration-none(href="#") Read More
                            .step-item
                                .step-number 13
                                .step-content
                                    h6.text-purple.mb-2.fw-medium.fs-20 Submit the Tax Return and Settle Dues
                                    p.mb-2.discription Submit the Tax Return and pay any due tax within six months after the financial year-end (typically 31st December). 
                                    a.fs-16.text-purple.text-decoration-none(href="#") Read More
                            .step-item
                                .step-number 14
                                .step-content
                                    h6.text-purple.mb-2.fw-medium.fs-20 Submit the Employees List to the ESO
                                    p.mb-2.discription Submit an updated employees list the Legislation and Compliance tab in the portal by January and July of each year. 
                                    a.fs-16.text-purple.text-decoration-none(href="#") Read More        

            
            
                 
          

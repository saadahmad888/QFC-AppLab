                a.btn-tab(id="tab6" data-bs-toggle="tab" data-bs-target="#tab-pane-6" type="button" role="tab" aria-controls="tab-pane-6" aria-selected="false") Employment Standards Office
                a.btn-tab(id="tab7" data-bs-toggle="tab" data-bs-target="#tab-pane-7" type="button" role="tab" aria-controls="tab-pane-7" aria-selected="false") Data Protection


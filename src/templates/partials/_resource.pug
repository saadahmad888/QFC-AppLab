+section('sec-padding d-none')
    .row
        .col.text-center
            h4.mb-5.text-center.fw-medium.fs-24.section-title.text-primary Your one-stop-shop for all QFC brochures, guides, forms, and more
            
    .media-centre-tabs
            .tabs-wrapper(id="myTab", role="tablist")
                a.btn-tab(id="tab1" data-bs-toggle="tab" data-bs-target="#tab-pane-1" type="button" role="tab" aria-controls="tab-pane-1" aria-selected="false" ) All

+section('financial-lists sec-padding pt-0') 
        .row
            .col-12
                h2.fs-40.text-primary.fw-medium.mb-lg-4.mb-4 Financial Solutions
        .row.row-cols-1.row-cols-md-2.row-cols-lg-3.gy-4.mt-1        
            .col
                .financial-card
                    .financial-card-icon
                        img(src="assets/images/icons/cash.svg", alt="Traditional Finance")
                    h3.financial-card-title Traditional Finance
                    .financial-card-description
                        p QFC offers service providers a platform to expand their reach, connect with global clients, and deliver value in a pro-business environment.
                        p Understanding the local commercial ecosystem is the first critical step toward successful market entry and sustainable growth.
                    .financial-card-actions
                        a(href="#") 
                            span Banking
                            img(src="assets/images/icons/right-arrow.svg", alt="Banking")
                        a(href="#") 
                            span Insurance & Reinsurance
                            img(src="assets/images/icons/right-arrow.svg", alt="Insurance & Reinsurance")
            .col
                .financial-card
                    .financial-card-icon
                        img(src="assets/images/icons/digital.svg", alt="Digital Finance")
                    h3.financial-card-title Digital Finance
                    .financial-card-description
                        p QFC offers service providers a platform to expand their reach, connect with global clients, and deliver value in a pro-business environment.
                        p Our digital finance solutions enable innovative financial technology companies to thrive in Qatar's dynamic market.
                    .financial-card-actions
                        a(href="#") 
                            span Digital Assets
                            img(src="assets/images/icons/right-arrow.svg", alt="Digital Assets")
                        a(href="#") 
                            span Fintech
                            img(src="assets/images/icons/right-arrow.svg", alt="Fintech")
            .col
                .financial-card

+section('updates') 
    .row.mb-5.pb-3 
        .col.mb-3
            +tabList('simpleTabs', 
                {item: 'Annual Reports', id: 'annualreport-tab', targetID: 'annualreport', class: 'active'}, 
                {item: 'Research & Reports', id: 'researchreport-tab', targetID: 'researchreport'},
                {item: 'Mixed Reports', id: 'mixedreports-tab', targetID: 'mixedreports'})
        .col-auto.mb-3
            +filterFields({type: 'searchbox', name: 'Search'}, {type: 'select2box', options:['All Categories', 'Category1']},
            {type: 'select2box', options:['All Language', 'Category1']}, {type: 'select2box', options:['Sort by Year', '2025', '2024', '2023', '2022']})
    .row 
        .col-12
            .tab-content
                .tab-pane.active#annualreport
                    .row 
                        .col-12.col-md-6
                            .card.mb-4.card-list.publications
                                .card-body.p-0.h-100
                                    .publications-wrapper.h-100
                                        figure.mb-0
                                            img.img-fluid(src='assets/images/public-1.png')
                                        .publications-details
                                            span.fw-semibold.fs-20 2023
                                            h5.card-title.fw-medium.text-secondary.fs-24 Promoting Qatar as a Global Hub for Business Growth
                                            
                                            .publications-btns
                                                a.btn.more-btn.fs-16(href="#") View more

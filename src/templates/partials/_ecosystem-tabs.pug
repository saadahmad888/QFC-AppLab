                        data-bs-target="#tab2",
                        type="button"
                    ) South America
                li.nav-item
                    button.nav-link(
                        data-bs-toggle="tab",
                        data-bs-target="#tab3",
                        type="button"
                    ) Africa
                li.nav-item
                    button.nav-link(
                        data-bs-toggle="tab",
                        data-bs-target="#tab4",
                        type="button"
                    ) Europe
                li.nav-item
                    button.nav-link(
                        data-bs-toggle="tab",
                        data-bs-target="#tab5",
                        type="button"
                    ) Asia
                li.nav-item
                    button.nav-link(
                        data-bs-toggle="tab",
                        data-bs-target="#tab6",
                        type="button"
                    ) Australia


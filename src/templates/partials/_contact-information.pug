                {column:'6', type:"radio", label:"Have you reported the activity to your employer? *", name:"qfc-licensed", options:[{id:"qfc-yes", value:"yes", text:"Yes", checked:false}, {id:"qfc-no", value:"no", text:"No", checked:true}]},

+section('about-us') 
        .row.align-items-center.justify-content-between 
            .col-12.col-lg-6
                +title('mb-4 fs-40','Post-Registration Journey','Once your firm is registered you will be provided with dedicated support to ensure a smooth onboarding process. A typical client journey post registration will look like the illustration below')  

            .col-12.col-lg-5
                .video-container.mt-lg-0.mt-1.h-100.ratio 
                    video.w-100.h-100(src="assets/videos/about.mp4" autoplay="" muted="" loop="" controls height="100%") 
                    button.video-btn#videoToggle(aria-label="Play/Pause Video")
                        img(src="assets/images/icons/pause-icon.png", alt="pause icon")
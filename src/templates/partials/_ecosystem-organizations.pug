+section('ecosystem-organizations py-60')
    .row 
        .col-12
            +title('mb-4','QFC Affiliated Organisations')
    .row.mt-40.gx-xxl-5.justify-content-center
        .col-md-6.col-lg-3 
            .organization-wrapper 
                figure.ratio 
                    img.img-fluid(src="assets/images/TOP-2.png", alt="logo icon")
            .organization-wrapper.card 
                h4.fs-20.fw-medium Chairman
                p.fs-16.fw-normal.mb-0 H.E Minister of Commerce & Industry
            .organization-wrapper.content
                    h4.fs-20.fw-semibold Legal & Tax
                    p.fs-16.fw-normal.mb-0 licenses firms to conduct business in or from the QFC. Manages and maintains the QFC legal and tax environment
        .col-md-6.col-lg-3 
            .organization-wrapper 
                figure.ratio 
                    img.img-fluid(src="assets/images/TOP-1.png", alt="logo icon")
            .organization-wrapper.card 
                h4.fs-20.fw-medium Chairman
                p.fs-16.fw-normal.mb-0 H.E Minister of Commerce & Industry
            .organization-wrapper.content
                    h4.fs-20.fw-semibold Regulated Activities
                    p.fs-16.fw-normal.mb-0 Regulates, authorises and supervises QFC firms conducting regulated activities
        .col-md-12.col-lg-6 
            .organization-wrapper 
                figure.img-lg.ratio 
                    img.img-fluid(src="assets/images/Top-3.png", alt="logo icon")
            .d-flex.w-100.gap-4.flex-wrap.flex-sm-nowrap
                .organization-wrapper.card.w-50 
                    h4.fs-20.fw-medium Chairman
                    p.fs-16.fw-normal.mb-0 H.E Minister of Commerce & Industry
                .organization-wrapper.card.w-50 
                    h4.fs-20.fw-medium Chairman
                    p.fs-16.fw-normal.mb-0 H.E Minister of Commerce & Industry
            .organization-wrapper.content
                h4.fs-20.fw-semibold Dispute Resolution
                .d-flex.flex-wrap.flex-sm-nowrap
                    .content-block
                        h5.fs-16.fw-semibold Civil & Commercial Court
                        p.fs-16.fw-normal Hears Civil and commercial disputes between QFC firms and their counterparts
                    .content-block
                        h5.fs-16.fw-semibold Regulatory Tribunal
                        p.fs-16.fw-normal Hears appeals relating to decisions made by the QFC authorities or institutions
            
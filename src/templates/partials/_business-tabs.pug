+section('business sec-padding bg-light-bg ') 
        .row
            .col-12.col-lg-4
                +title('mb-4 fs-40','Financial Solutions','')  

            .col-12.col-lg-8
                +title('mb-4 fs-40','','Launch and scale fintech solutions with Qatars leading regulatory platform. Access digital banking infrastructure, payment systems, and capital markets through streamlined licensing that accelerates your time to market. Benefit from 100% foreign ownership and zero corporate tax for guaranteed periods. Connect instantly to regional markets through our established network of financial institutions and banking partners. ')  

        .row.mt-lg-5.mt-4 

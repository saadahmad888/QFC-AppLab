                    button.business-tab-btn.active(id="btn-alternative" data-bs-toggle="tab" data-bs-target="#tab-alternative" type="button" role="tab" aria-controls="tab-alternative" aria-selected="true") Alternative Finance
                    button.business-tab-btn(id="btn-capital" data-bs-toggle="tab" data-bs-target="#tab-capital" type="button" role="tab" aria-controls="tab-capital" aria-selected="false") Capital Markets


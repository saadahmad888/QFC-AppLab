.d-flex.justify-content-center
  nav(aria-label="Page navigation")
    ul.pagination
      li.page-item.page-prev
        a.page-link(href="#", aria-label="Previous")
          span 
            i.bi.bi-chevron-left
      li.page-item.active
        a.page-link(href="#") 1
      li.page-item
        a.page-link(href="#") 2
      li.page-item
        a.page-link(href="#") 3
      li.page-item
        a.page-link(href="#") ...
      li.page-item
        a.page-link(href="#") 10
      li.page-item.page-next
        a.page-link(href="#", aria-label="Next")
          span 
            i.bi.bi-chevron-right.next

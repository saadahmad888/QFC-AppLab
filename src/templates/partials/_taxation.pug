include ../mixins/_filter-fields
+section('py-5 taxation-comp')
    .media-centre-tabs.taxation-media
            .tabs-wrapper.mb-5.pb-3(id="myTab", role="tablist")
                a.btn-tab.active(id="tab1" data-bs-toggle="tab" data-bs-target="#tab-pane-1" type="button" role="tab" aria-controls="tab-pane-1" aria-selected="true" ) What is a Double Taxation Agreement?
                a.btn-tab(id="tab2" data-bs-toggle="tab" data-bs-target="#tab-pane-2" type="button" role="tab" aria-controls="tab-pane-2" aria-selected="false") Qatar’s DTAs
                a.btn-tab(id="tab3" data-bs-toggle="tab" data-bs-target="#tab-pane-3" type="button" role="tab" aria-controls="tab-pane-3" aria-selected="false") Treaty Benefits
            .tab-content(id="myTabContent")
                .tab-pane.fade.show.active(id="tab-pane-1" role="tabpanel" aria-labelledby="tab1" tabindex="0")
                    .row.align-items-center.justify-content-between.g-0.taxation-media-content                
                        .col-lg-5
                            figure.ratio
                                img.img-fluid.fig-radius(src='assets/images/tax-1.png', loading='lazy', width='', height='', alt='')
                        .col-lg-6
                            h4.fw-500.fs-32.text-primary What is a Double Taxation Agreement?
                            p.fs-20.fw-400.text-secondary Double Taxation Agreements (DTAs) are treaties between two or more jurisdictions to avoid double taxation. They allow the contracting jurisdictions to share their taxation rights in relation to income earned by their respective residents. They also allow prevention of tax evasion and ensure that taxpayers in both jurisdictions are treated equally.        
                .tab-pane.fade(id="tab-pane-2" role="tabpanel" aria-labelledby="tab2" tabindex="0")
                    .row.align-items-center.justify-content-between.g-0
                        .col-lg-6
                            h4.fw-500.fs-32.text-primary Qatar’s DTAs
                            p.fs-20.fw-400.text-secondary Qatar has concluded more than 80 DTAs with most of its economic partners. While there are certain common features in these DTAs, each agreement remains a different and separate treaty with its own provisions. It is, therefore, necessary to check the respective agreement to ascertain the tax position and the benefits potentially available under the treaty.
                        .col-lg-5
                            figure
                                //- img.img-fluid.fig-radius(src='assets/images/tax-2.png', loading='lazy', width='', height='', alt='')
                                video.fig-media(controls preload="metadata" loading="lazy")
                                    source(src="https://videos.pexels.com/video-files/6580589/6580589-uhd_2732_1440_25fps.mp4" type="video/mp4")
                                    | Your browser does not support the video tag.

                .tab-pane.fade(id="tab-pane-3" role="tabpanel" aria-labelledby="tab3" tabindex="0")
                    .row.align-items-center.justify-content-between.g-0
                        .col-lg-6
                            h4.fw-500.fs-32.text-primary Treaty Benefits
                            p.fs-20.fw-400.text-secondary Tax benefits under DTA include non-taxation of non-resident companies with no permanent establishments in Qatar and reduced rates of (or exemption from) withholding tax on payments made to Qatari residents, provided certain conditions are met.
                        .col-lg-5
                            figure
                                //- img.img-fluid.fig-radius(src='assets/images/tax-3.png', loading='lazy', width='', height='', alt='')
                                .ratio.ratio-16x9
                                    iframe.fig-media(
                                        src="https://www.youtube.com/embed/21BZPF8T2Js?si=3tfoJvuaGeTqxRxA"
                                        title="YouTube video"
                                        frameborder="0"
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                                        allowfullscreen
                                    )


+section('about-us py-60') 
        .row.align-items-center.justify-content-between 
            .col-12.col-lg-6
                +title('mb-4 fs-40','Whistle Blowing','The QFC Authority (QFCA) is committed to the highest possible standards of openness, professionalism, and accountability. In line with this commitment, we encourage our stakeholders to report their concerns about any suspected or illegal practices conducted either by our staff or by individuals or entities who act on behalf of the QFCA. The QFCA undertakes to review, within a reasonable timeframe, all reports submitted in good faith.')  

            .col-12.col-lg-5
                .video-container.h-100.ratio 
                    video.w-100.h-100(src="assets/videos/about.mp4" autoplay="" muted="" loop="" height="100%" id="overviewVideo") 
                    button.video-btn#videoToggle(aria-label="Play/Pause Video")
                        img(src="assets/images/icons/pause-icon.png", alt="pause icon")

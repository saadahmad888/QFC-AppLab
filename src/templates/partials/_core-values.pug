+section('core-values') 
    .row 
        .col-12
            +title('mb-4 text-center','Our Core Values', 'Integrity, innovation, collaboration, and excellence drive everything we do.', 'text-center')
            .qfca-wrapper
                .qfca-letters
                    span.letter(data-key="q", style="--letter-image: url(../../assets/images/letter-Q.webp);") Q
                    span.letter(data-key="f" style="--letter-image: url(../../assets/images/letter-F.webp)") F
                    span.letter(data-key="c" style="--letter-image: url(../../assets/images/letter-C.webp)") C
                    span.letter(data-key="a" style="--letter-image: url(../../assets/images/letter-A.webp)") A
                .qfca-content
                    .item(data-key="q")
                        h4.fs-24.text-primary Quality
                        p.fw-normal.fs-20.text-secondary We are committed to excellence in every operation and consistently deliver outstanding results with confidence.
                        span.line
                    .item(data-key="f")
                        h4.fs-24.text-primary Future Focus
                        p.fw-normal.fs-20.text-secondary We anticipate, adapt to, and capitalise on evolving business landscapes. We embrace learning and foster positive transformation.
                        span.line
                    .item(data-key="c")
                        h4.fs-24.text-primary Customer Focus
                        p.fw-normal.fs-20.text-secondary We are dedicated to prioritising the needs, satisfaction, and success of our customers. We are in business together.
                        span.line
                    .item(data-key="a")
                        h4.fs-24.text-primary Authenticity
                        p.fw-normal.fs-20.text-secondary We are genuine, transparent, and true to our purpose. Together, we create strategic solutions.
                        span.line

            
                        

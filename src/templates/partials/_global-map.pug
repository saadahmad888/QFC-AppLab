+section('ecosystem-map py-3')
    .row.media-centre-tabs
        .col
            .tabs-wrapper.justify-content-start
                a(href="#N-Ameria" class="btn-tab active") North America
                a(href="#S-Ameria" class="btn-tab") South America
                a(href="#Africa" class="btn-tab") Africa
                a(href="#Europe" class="btn-tab") Europe
                a(href="#Asia" class="btn-tab") Asia
                a(href="#Australia" class="btn-tab") Australia

            .tab-content 
                .tab-pane.active#N-Ameria
                    .row 
                        .col-12.col-md-12.col-lg-3.col-xl-3.mb-4.mb-lg-0
                           .country-list 
                            h4 Countries List 
                            ul 
                                li 
                                    a(href="#") United States of America
                                li 
                                    a(href="#") Canada
                                li 
                                    a(href="#") Mexico
                                li 
                                    a(href="#") Panama
                                li 
                                    a(href="#") US Virgin Islands
                                li 
                                    a(href="#") Cabo Verde
                        .col-12.col-md-12.col-lg-9.mb-4.col-xl-9
                            .world-map.d-flex.align-items-center.justify-content-center
                                figure 
                                    img(src="assets/images/north-america.svg", class="img-fluid", alt="North America map")
                
                .tab-pane#S-Ameria
                    .row 
                        .col-12.col-md-12.col-lg-3.col-xl-3.mb-4.mb-lg-0

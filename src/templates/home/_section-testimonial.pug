                {label: 'Echoes of Success feat. Doha Tech Angels', heading:'Meet Majed Lababidi, Director  of Ecosystem Integration at Alchemist Doha.', details: 'Leveraging Alchemist’s global network, Alchemist Doha invests in founders with promising products and early market traction, while seamlessly connecting them to Qatar’s innovation ecosystem and global opportunities.', name: 'Majed Lababidi', role:'Director of Ecosystem Integration at Alchemist',  image: 'assets/images/testimonial3.png'},
                {label: 'Echoes of Success feat. Doha Tech Angels', heading:'Meet Sara Daniel, Managing Director of Doha Tech Angels (DTA) -  Qatar’s first private investment club.', details: 'DTA is on a mission to empower the next generation of tech disruptors, offering not just capital but also strategic insights, mentorship, and global connections to help early-stage startups thrive. <br> <br> Founded by 15 visionary partners, DTA brings together', name:'Sara Daniel', role: 'Director -  Doha Tech Angels', image: 'assets/images/testimonial1.png'})


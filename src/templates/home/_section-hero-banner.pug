section.hero-banner
    .hero-banner-main
        .container-lg
            .row
                .col-12
                    .video-box
                        video(
                            autoplay
                            muted
                            loop
                            playsinline
                            preload="auto"
                        )
                            source(src="assets/videos/hero-banner.mp4" type="video/mp4")
                    .content-box
                        h1.fs-56.fw-medium.text-white.mb-1rem
                            | Qatar’s Premier On-Shore/
                            br
                            |Business & Financial Hub
                        h4.fs-24.fw-normal.text-white.mb-0
                            |Launch Your Business with Confidence in Qatar​
                        .button-box.mt-2rem
                            a.updated-primary-btn.fs-16.fw-medium(href="#")
                                span
                                    |Start your journey
                            a.btn.btn-white.fs-16.fw-medium(href="#")
                                |Solutions 
                    .slider-box
                        .hero-slider.js-hero-slider
                            .slider-item
                                figure
                                    img(src="assets/images/hero-banner/banner-slider-image.svg" alt="Banner Slider Image")
                                .content
                                    h4.fs-20.fw-medium.text-white.truncate-line-1
                                        |Company Setup
                                    p.fs-16.fw-normal.text-white.truncate-line-3
                                        |Ready to launch? Use the Start Your Setup wizard to submit an application and get your business off the ground with ease.
                                    a.link.white.with-arrow.fs-16.fw-medium(href="")
                                        |Learn more
                            .slider-item.has-icon
                                figure
                                    img(src="assets/images/icons/white-file-icon.svg" alt="Banner Slider Icon")
                                .content
                                    h4.fs-20.fw-medium.text-white.truncate-line-1
                                        |Company Setup
                                    p.fs-16.fw-normal.text-white.truncate-line-3
                                        |Ready to launch? Use the Start Your Setup wizard to submit an application and get your business off the ground with ease.
                                    a.link.white.with-arrow.fs-16.fw-medium(href="")
                                        |Learn more
                            .slider-item
                                    figure
                                        img(src="assets/images/hero-banner/banner-slider-image.svg" alt="Banner Slider Image")
                                    .content
                                        h4.fs-20.fw-medium.text-white.truncate-line-1
                                            |Company Setup
                                        p.fs-16.fw-normal.text-white.truncate-line-3
                                            |Ready to launch? Use the Start Your Setup wizard to submit an application and get your business off the ground with ease.
                                        a.link.white.with-arrow.fs-16.fw-medium(href="")
                                            |Learn more
                    a.scroll-down(href="")
